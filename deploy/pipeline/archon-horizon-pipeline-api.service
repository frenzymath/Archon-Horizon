[Unit]
Description=Archon Horizon Pipeline API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/.local/share/archon-horizon-pipeline
Environment=TMPDIR=%h/.local/share/archon-horizon-pipeline/tmp
ExecStart=%h/.local/share/archon-horizon/venv/bin/horizon-pipeline --config %h/.config/archon-horizon-pipeline/server.json serve
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=true
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=default.target
